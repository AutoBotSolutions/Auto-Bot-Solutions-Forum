# Notification System Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# NOTIFICATION SYSTEM CORE SETTINGS
# =============================================================================

# Enable/disable notification system
NOTIFICATION_ENABLED=true

# Default notification settings
NOTIFICATION_MAX_LENGTH=500
NOTIFICATION_RATE_LIMIT="100 per hour"
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_ARCHIVE_DAYS=30

# =============================================================================
# WEBSOCKET NOTIFICATION SETTINGS
# =============================================================================

# WebSocket server configuration
WEBSOCKET_NOTIFICATION_URL=ws://localhost:5003
WEBSOCKET_NOTIFICATION_HOST=localhost
WEBSOCKET_NOTIFICATION_PORT=5003
WEBSOCKET_NOTIFICATION_DEBUG=false

# WebSocket authentication
WEBSOCKET_SECRET_KEY=your-websocket-secret-key-here
WEBSOCKET_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# WebSocket performance settings
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_HEARTBEAT_INTERVAL=25
WEBSOCKET_HEARTBEAT_TIMEOUT=60

# =============================================================================
# EMAIL NOTIFICATION SETTINGS
# =============================================================================

# SMTP server configuration
SMTP_NOTIFICATION_SERVER=smtp.example.com
SMTP_NOTIFICATION_PORT=587
SMTP_NOTIFICATION_USE_TLS=true
SMTP_NOTIFICATION_USE_SSL=false

# SMTP authentication
SMTP_NOTIFICATION_USERNAME=your-smtp-username
SMTP_NOTIFICATION_PASSWORD=your-smtp-password
SMTP_NOTIFICATION_DEFAULT_SENDER=noreply@yourdomain.com
SMTP_NOTIFICATION_DEFAULT_SENDER_NAME=AutoBot Solutions Forum

# Email notification settings
EMAIL_NOTIFICATION_ENABLED=true
EMAIL_NOTIFICATION_BATCH_SIZE=50
EMAIL_NOTIFICATION_RETRY_ATTEMPTS=3
EMAIL_NOTIFICATION_RETRY_DELAY=5

# Email queue settings
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_WORKERS=4
EMAIL_QUEUE_MAX_SIZE=1000
EMAIL_QUEUE_PROCESSING_INTERVAL=30

# Email templates
EMAIL_TEMPLATE_DIR=app/templates/email/notifications
EMAIL_TEMPLATE_CACHE_ENABLED=true

# =============================================================================
# PUSH NOTIFICATION SETTINGS
# =============================================================================

# Push notification service configuration
PUSH_NOTIFICATION_ENABLED=true
PUSH_NOTIFICATION_BATCH_SIZE=100
PUSH_NOTIFICATION_RETRY_ATTEMPTS=3
PUSH_NOTIFICATION_RETRY_DELAY=2

# VAPID configuration for web push notifications
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Apple Push Notification Service (APNS)
APNS_ENABLED=true
APNS_KEY_FILE=path/to/apns/key.p8
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=com.yourdomain.app
APNS_SANDBOX=true

# Firebase Cloud Messaging (FCM)
FCM_ENABLED=true
FCM_SERVER_KEY=your-fcm-server-key-here
FCM_SENDER_ID=your-fcm-sender-id

# Huawei Mobile Services (HMS)
HMS_ENABLED=true
HMS_APP_ID=your-hms-app-id
HMS_APP_SECRET=your-hms-app-secret

# =============================================================================
# MOBILE NOTIFICATION SETTINGS
# =============================================================================

# Mobile notification settings
MOBILE_NOTIFICATION_ENABLED=true
MOBILE_NOTIFICATION_MAX_DEVICES_PER_USER=10
MOBILE_NOTIFICATION_DEVICE_EXPIRY_DAYS=365
MOBILE_NOTIFICATION_CLEANUP_INTERVAL=24

# Mobile notification platforms
MOBILE_PLATFORMS_ENABLED=ios,android,huawei,web

# Mobile notification types
MOBILE_NOTIFICATION_TYPES=forum_activity,messages,moderation,security,system,marketing

# =============================================================================
# TRANSLATION SYSTEM SETTINGS
# =============================================================================

# Translation service configuration
TRANSLATION_ENABLED=true
TRANSLATION_DEFAULT_LANGUAGE=en
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL=3600

# Supported languages
TRANSLATION_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ru,zh,ja,ko,ar,hi

# Translation service API (if using external service)
TRANSLATION_API_ENABLED=false
TRANSLATION_API_KEY=your-translation-api-key
TRANSLATION_API_URL=https://api.translation.service.com

# =============================================================================
# FILTERING AND GROUPING SETTINGS
# =============================================================================

# Filtering service configuration
FILTERING_ENABLED=true
FILTERING_CACHE_ENABLED=true
FILTERING_CACHE_TTL=1800
FILTERING_MAX_CUSTOM_FILTERS=50

# Grouping service configuration
GROUPING_ENABLED=true
GROUPING_SIMILARITY_THRESHOLD=0.7
GROUPING_MAX_GROUP_SIZE=20
GROUPING_CACHE_ENABLED=true

# Pattern analysis settings
PATTERN_ANALYSIS_ENABLED=true
PATTERN_ANALYSIS_MIN_DATA_POINTS=10
PATTERN_ANALYSIS_CACHE_TTL=7200

# =============================================================================
# ARCHIVING SYSTEM SETTINGS
# =============================================================================

# Archiving configuration
ARCHIVING_ENABLED=true
ARCHIVING_AUTO_ENABLED=true
ARCHIVING_SCHEDULE="0 2 * * *"  # Daily at 2 AM
ARCHIVING_BATCH_SIZE=500

# Archiving rules
ARCHIVING_READ_OLDER_THAN_DAYS=90
ARCHIVING_UNREAD_OLDER_THAN_DAYS=365
ARCHIVING_KEEP_IMPORTANT=true
ARCHIVING_KEEP_UNREAD=true

# Archive storage
ARCHIVE_STORAGE_TYPE=database
ARCHIVE_RETENTION_DAYS=1095  # 3 years
ARCHIVE_COMPRESSION_ENABLED=true

# =============================================================================
# SCHEDULING SYSTEM SETTINGS
# =============================================================================

# Scheduling configuration
SCHEDULING_ENABLED=true
SCHEDULING_TIMEZONE=UTC
SCHEDULING_BATCH_SIZE=100

# Digest settings
DIGEST_ENABLED=true
DIGEST_DEFAULT_TIME="09:00"
DIGEST_WEEKLY_DAY="monday"
DIGEST_MAX_NOTIFICATIONS=50

# Quiet hours settings
QUIET_HOURS_ENABLED=true
QUIET_HOURS_DEFAULT_START="22:00"
QUIET_HOURS_DEFAULT_END="08:00"
QUIET_HOURS_WEEKEND_ENABLED=true
QUIET_HOURS_WEEKEND_START="23:00"
QUIET_HOURS_WEEKEND_END="09:00"

# =============================================================================
# ANALYTICS AND MONITORING SETTINGS
# =============================================================================

# Analytics configuration
NOTIFICATION_ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=1000

# Performance monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_SAMPLE_RATE=0.1
PERFORMANCE_SLOW_QUERY_THRESHOLD=1000

# Error tracking
ERROR_TRACKING_ENABLED=true
ERROR_NOTIFICATION_EMAIL=admin@yourdomain.com
ERROR_WEBHOOK_URL=https://hooks.slack.com/your-webhook

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Security configuration
NOTIFICATION_SECURITY_ENABLED=true
NOTIFICATION_ENCRYPTION_ENABLED=false
NOTIFICATION_SIGNATURE_ENABLED=true

# Rate limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_NOTIFICATIONS=100
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_STRATEGY=sliding-window

# Access control
ACCESS_CONTROL_ENABLED=true
NOTIFICATION_PERMISSION_CHECK=true
ADMIN_NOTIFICATION_OVERRIDE=true

# =============================================================================
# DEVELOPMENT AND DEBUGGING
# =============================================================================

# Development settings
DEBUG_NOTIFICATIONS=false
NOTIFICATION_DEBUG_LEVEL=INFO
NOTIFICATION_LOG_QUERIES=false

# Testing settings
TEST_NOTIFICATION_MODE=false
TEST_EMAIL_RECIPIENT=test@yourdomain.com
TEST_MOBILE_DEVICE_TOKEN=test-device-token

# =============================================================================
# REDIS CONFIGURATION (for caching and queues)
# =============================================================================

# Redis settings
REDIS_URL=redis://localhost:6379/0
REDIS_NOTIFICATION_DB=1
REDIS_CACHE_DB=2
REDIS_QUEUE_DB=3

# Redis connection settings
REDIS_CONNECTION_POOL_SIZE=10
REDIS_CONNECTION_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database settings for notifications
DATABASE_NOTIFICATION_POOL_SIZE=20
DATABASE_NOTIFICATION_MAX_OVERFLOW=30
DATABASE_NOTIFICATION_POOL_TIMEOUT=30

# Notification database optimization
NOTIFICATION_DB_INDEXING_ENABLED=true
NOTIFICATION_DB_PARTITIONING_ENABLED=false
NOTIFICATION_DB_SHARDING_ENABLED=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging settings
NOTIFICATION_LOG_LEVEL=INFO
NOTIFICATION_LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
NOTIFICATION_LOG_FILE=logs/notifications.log
NOTIFICATION_LOG_MAX_SIZE=10485760  # 10MB
NOTIFICATION_LOG_BACKUP_COUNT=5

# Specific service logging
TRANSLATION_LOG_LEVEL=INFO
FILTERING_LOG_LEVEL=INFO
MOBILE_LOG_LEVEL=INFO
EMAIL_LOG_LEVEL=INFO

# =============================================================================
# THIRD-PERVICE INTEGRATIONS
# =============================================================================

# Slack integration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_NOTIFICATION_CHANNEL=#notifications

# Discord integration (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Twilio integration (optional for SMS notifications)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================

# Caching settings
CACHE_NOTIFICATION_ENABLED=true
CACHE_NOTIFICATION_TTL=300
CACHE_NOTIFICATION_MAX_SIZE=1000

# Background processing
BACKGROUND_WORKERS_ENABLED=true
BACKGROUND_WORKERS_COUNT=4
BACKGROUND_TASK_TIMEOUT=300

# Connection pooling
NOTIFICATION_CONNECTION_POOL_SIZE=20
NOTIFICATION_CONNECTION_MAX_OVERFLOW=30

# =============================================================================
# COMPLIANCE AND PRIVACY
# =============================================================================

# GDPR compliance
GDPR_COMPLIANCE_ENABLED=true
NOTIFICATION_DATA_RETENTION_DAYS=2555  # 7 years
NOTIFICATION_ANONYMIZATION_ENABLED=true

# Privacy settings
PRIVACY_MODE_ENABLED=false
NOTIFICATION_CONTENT_ENCRYPTION=false
NOTIFICATION_METADATA_ENCRYPTION=false

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10

# Metrics collection
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
METRICS_PORT=9090

# Alerting
ALERTING_ENABLED=true
ALERTING_WEBHOOK_URL=https://your-alerting-system.com/webhook
ALERTING_THRESHOLD_ERROR_RATE=0.05
ALERTING_THRESHOLD_RESPONSE_TIME=1000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature flags for experimental features
FEATURE_ADVANCED_FILTERING=true
FEATURE_SMART_GROUPING=true
FEATURE_AI_TRANSLATIONS=false
FEATURE_VOICE_NOTIFICATIONS=false
FEATURE_VIDEO_NOTIFICATIONS=false

# Beta features
BETA_FEATURES_ENABLED=false
BETA_TRANSLATION_MODELS=false
BETA_MOBILE_PLATFORMS=false

# =============================================================================
# MIGRATION AND BACKUP
# =============================================================================

# Migration settings
MIGRATION_BACKUP_ENABLED=true
MIGRATION_BATCH_SIZE=1000
MIGRATION_TIMEOUT=3600

# Backup settings
BACKUP_NOTIFICATIONS_ENABLED=true
BACKUP_SCHEDULE="0 3 * * 0"  # Weekly on Sunday at 3 AM
BACKUP_RETENTION_DAYS=90

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Custom notification settings
CUSTOM_NOTIFICATION_TEMPLATES_ENABLED=true
CUSTOM_NOTIFICATION_FIELDS_ENABLED=false
CUSTOM_NOTIFICATION_VALIDATORS=false

# Plugin system
PLUGIN_SYSTEM_ENABLED=false
PLUGIN_NOTIFICATION_HOOKS=false

# =============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# =============================================================================

# Development environment
if [ "$FLASK_ENV" = "development" ]; then
    NOTIFICATION_DEBUG=true
    NOTIFICATION_LOG_LEVEL=DEBUG
    WEBSOCKET_NOTIFICATION_DEBUG=true
    EMAIL_NOTIFICATION_ENABLED=false
    PUSH_NOTIFICATION_ENABLED=false
fi

# Testing environment
if [ "$FLASK_ENV" = "testing" ]; then
    NOTIFICATION_ENABLED=false
    WEBSOCKET_NOTIFICATION_ENABLED=false
    EMAIL_NOTIFICATION_ENABLED=false
    PUSH_NOTIFICATION_ENABLED=false
    TEST_NOTIFICATION_MODE=true
fi

# Production environment
if [ "$FLASK_ENV" = "production" ]; then
    NOTIFICATION_DEBUG=false
    NOTIFICATION_LOG_LEVEL=WARNING
    WEBSOCKET_NOTIFICATION_DEBUG=false
    PERFORMANCE_MONITORING_ENABLED=true
    ERROR_TRACKING_ENABLED=true
fi
