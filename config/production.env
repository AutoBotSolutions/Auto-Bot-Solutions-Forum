# Production Environment Configuration
# Auto Bot Solutions Forum - User Management Systems

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/autobot_forum_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-production-key-here
DEBUG=False
TESTING=False

# Security Configuration
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# Cache Configuration (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_REDIS_DB=0
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_KEY_PREFIX=autobot:prod:

# User Management System Configuration
USER_PROFILE_UPLOAD_PATH=/var/www/autobot/uploads/profiles
USER_ANALYTICS_ENABLED=True
SOCIAL_FEATURES_ENABLED=True
PROFILE_CUSTOMIZATION_ENABLED=True
USER_ROLE_MANAGEMENT_ENABLED=True

# Profile Customization Settings
PROFILE_MAX_BANNER_SIZE=5242880  # 5MB
PROFILE_ALLOWED_BANNER_TYPES=jpg,jpeg,png,gif,webp
PROFILE_DEFAULT_THEME=light
PROFILE_MAX_WIDGETS=10

# User Preferences Settings
USER_PREFERENCES_CACHE_TIMEOUT=300
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_QUEUE_NAME=user_notifications

# Social Features Settings
SOCIAL_FOLLOW_LIMIT=1000
SOCIAL_FRIEND_REQUEST_LIMIT=50
SOCIAL_GROUP_MEMBER_LIMIT=1000
SOCIAL_ACTIVITY_FEED_LIMIT=100
SOCIAL_RECOMMENDATION_CACHE_TIMEOUT=600

# Analytics Settings
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_REAL_TIME_ENABLED=True
ANALYTICS_PREDICTION_MODEL_PATH=/var/www/autobot/models/
ANALYTICS_CACHE_TIMEOUT=600

# Role Management Settings
ROLE_CACHE_TIMEOUT=300
ROLE_ASSIGNMENT_CACHE_TIMEOUT=180
ROLE_ANALYTICS_CACHE_TIMEOUT=600
ROLE_HIERARCHY_MAX_DEPTH=10

# Performance Optimization Settings
PROFILE_CACHE_TIMEOUT=300
ANALYTICS_CACHE_TIMEOUT=600
SOCIAL_CACHE_TIMEOUT=300
ROLE_CACHE_TIMEOUT=300

# Rate Limiting Configuration
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=100/hour
RATELIMIT_AUTH=10/minute
RATELIMIT_API=1000/hour
RATELIMIT_UPLOAD=10/minute

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@autobotsolutions.com
MAIL_SUPPRESS_SEND=False

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# WebSocket Configuration
SOCKETIO_ASYNC_MODE=gevent
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/3
SOCKETIO_CORS_ALLOWED_ORIGINS=https://autobotsolutions.com

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=/var/www/autobot/uploads
UPLOAD_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/autobot/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Monitoring and Metrics
METRICS_ENABLED=True
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=True

# Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Content Security Policy
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' https://cdn.jsdelivr.net"
CSP_STYLE_SRC="'self' 'unsafe-inline' https://cdn.jsdelivr.net"
CSP_IMG_SRC="'self' data: https:"
CSP_FONT_SRC="'self' https://fonts.gstatic.com"

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=True
SLOW_QUERY_THRESHOLD=1.0
MEMORY_USAGE_THRESHOLD=0.8

# Feature Flags
ENABLE_USER_ANALYTICS=True
ENABLE_SOCIAL_FEATURES=True
ENABLE_ROLE_MANAGEMENT=True
ENABLE_PROFILE_CUSTOMIZATION=True
ENABLE_USER_PREFERENCES=True

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/autobot

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/autobot.crt
SSL_KEY_PATH=/etc/ssl/private/autobot.key

# API Configuration
API_VERSION=v1
API_PREFIX=/api
API_DOCS_ENABLED=False
API_RATE_LIMIT=1000/hour

# Development Overrides (set to False in production)
DEVELOPMENT_MODE=False
TESTING_MODE=False
DEBUG_TB_ENABLED=False
